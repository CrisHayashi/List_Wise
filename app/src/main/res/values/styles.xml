<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Seu estilo BotaoAzul -->
    <style name="BotaoAzul">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="BottomNavigationViewLargeIcon" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="iconSize">36dp</item> <!-- Tamanho desejado -->
    </style>

    <!-- Estilo para os dropdowns de Aparência / Idioma -->
    <style name="Widget.ListWise.ExposedDropdown"
        parent="Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/colorSurface</item>
        <item name="boxStrokeColor">@color/colorSecondaryText</item>
        <item name="android:textColor">@color/colorOnBackground</item>
        <item name="hintTextColor">@color/colorSecondaryText</item>
    </style>

    <style name="Widget.ListWise.ButtonSurface" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/colorSurface</item>
        <item name="android:textColor">@color/colorOnSurface</item>
        <item name="cornerRadius">12dp</item>
    </style>

</resources>
