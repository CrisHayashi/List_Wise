<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    android:layout_marginHorizontal="4dp"
    app:cardElevation="4dp"
    app:cardCornerRadius="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Nome da lista -->
        <TextView
            android:id="@+id/txtListName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Feira Mensal"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Local -->
        <TextView
            android:id="@+id/txtListLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Local: Feira"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/txtListName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="4dp"/>

        <!-- Endereço -->
        <TextView
            android:id="@+id/txtListAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Av. Cons. Aguiar, 850 - Boa Viagem"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/txtListLocation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="2dp"/>

        <!-- Valor total -->
        <TextView
            android:id="@+id/txtListTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R$ 2.598,56"
            android:textSize="14sp"
            android:textColor="@android:color/holo_green_dark"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/txtListAddress"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="6dp"/>

        <!-- Data -->
        <TextView
            android:id="@+id/txtListDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15/09/2025"
            android:textSize="14sp"
            app:layout_constraintTop_toTopOf="@id/txtListTotal"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Status -->
        <TextView
            android:id="@+id/txtListStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="48 Itens"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            app:layout_constraintTop_toBottomOf="@id/txtListTotal"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="4dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
