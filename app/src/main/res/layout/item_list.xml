<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <CheckBox
        android:id="@+id/checkItemBought"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/txtItemName"
        android:text="Arroz Parboilizado"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/checkItemBought"
        app:layout_constraintEnd_toStartOf="@id/txtItemPrice"
        app:layout_constraintTop_toTopOf="@id/checkItemBought"
        android:layout_marginStart="8dp"/>

    <TextView
        android:id="@+id/txtItemPrice"
        android:text="R$ 5,00"
        android:textColor="@android:color/holo_green_dark"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/txtItemName"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txtItemDetails"
        android:text="Tio João, 5 unid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/txtItemName"
        app:layout_constraintTop_toBottomOf="@id/txtItemName"/>

    <ImageButton
        android:id="@+id/btnEdit"
        android:src="@android:drawable/ic_menu_edit"
        android:background="?selectableItemBackgroundBorderless"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/txtItemDetails"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageButton
        android:id="@+id/btnDelete"
        android:src="@android:drawable/ic_delete"
        android:background="?selectableItemBackgroundBorderless"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/btnEdit"
        app:layout_constraintEnd_toStartOf="@id/btnEdit"
        android:layout_marginEnd="4dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>