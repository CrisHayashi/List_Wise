<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Nome da lista -->
    <TextView
        android:id="@+id/textListName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/shopping_list_title_default"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/colorOnBackground"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Dica do modo compra -->
    <TextView
        android:id="@+id/textShoppingHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/shopping_hint"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/textListName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Lista de categorias + itens (mesmo adapter da tela de lista) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewCategories"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/textShoppingHint"
        app:layout_constraintBottom_toTopOf="@+id/dividerBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Divisor acima do rodapé -->
    <View
        android:id="@+id/dividerBottom"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:background="@android:color/darker_gray"
        android:alpha="0.2"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- RODAPÉ COM OS DOIS BOTÕES LADO A LADO -->
    <!-- btnEditList DENTRO do bottomBar junto com btnFinishPurchase -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Botão para voltar e editar a lista -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit_list"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:backgroundTint="@color/colorSurface"
            android:textColor="@color/colorOnSurface"
            android:layout_marginEnd="16dp"/>

            <!-- Botão de finalizar compra -->
            <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinishPurchase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/finish_purchase"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:backgroundTint="@color/colorOnBackground"
            android:textColor="@color/colorOnPrimary"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>