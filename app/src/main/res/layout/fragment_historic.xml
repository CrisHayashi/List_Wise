<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Gastos e Listas Finalizadas -->
    <LinearLayout
        android:id="@+id/headerStats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/txtMonthlyExpense"
                android:text="R$ 00,00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"/>

            <TextView
                android:text="Gastos este mês"
                android:textSize="14sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/txtCompletedListsCount"
                android:text="000"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"/>

            <TextView
                android:text="Listas finalizadas"
                android:textSize="14sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Itens mais comprados -->
    <TextView
        android:id="@+id/txtMostPurchasedTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Itens mais comprados"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/headerStats"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <TextView
        android:id="@+id/txtMostPurchasedSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Baseado no seu histórico de compras"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/txtMostPurchasedTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txtNoHistory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Finalize algumas listas para ver estatísticas"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"
        app:layout_constraintTop_toBottomOf="@id/txtMostPurchasedSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp"/>

    <!-- Botão Criar Lista -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCreateList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+ Criar Lista"
        app:layout_constraintTop_toBottomOf="@id/txtNoHistory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <!-- Título Listas Finalizadas -->
    <TextView
        android:id="@+id/txtCompletedListsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Listas finalizadas"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnCreateList"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <!-- RecyclerView das listas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewHistoric"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/txtCompletedListsTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>